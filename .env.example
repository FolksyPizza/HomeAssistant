HOST=0.0.0.0
PORT=8989

OLLAMA_BASE_URL=http://llm-server:11434
OLLAMA_MODEL=llama3.2:3b
ASSISTANT_MODE=browser-mic

HOME_ASSISTANT_BASE_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=your-long-lived-access-token

AMBIENT_PHOTO_SOURCE=bundled
# AMBIENT_PHOTO_DIR=/absolute/path/to/ambient-photos
# AMBIENT_PHOTO_REMOTE_MANIFEST_URL=https://example.com/ambient-photo-manifest.json

# WHISPER_TRANSCRIBE_URL=http://127.0.0.1:8080
# PI_VOICE_SERVICE_ENABLED=true
# PI_VOICE_PYTHON=python3
# PI_VOICE_HELPER_SCRIPT=scripts/pi_voice_bridge.py
# PI_VOICE_WAKE_WORD_MODEL=wakeword.onnx
# PI_VOICE_WHISPER_CLI=whisper.cpp/build/bin/whisper-cli
# PI_VOICE_WHISPER_MODEL=whisper.cpp/models/ggml-base.en.bin
# PI_VOICE_PIPER_BINARY=piper/piper
# PI_VOICE_PIPER_MODEL=piper/en_GB-semaine-medium.onnx
# PI_VOICE_INPUT_DEVICE=default
# PI_VOICE_INPUT_SAMPLE_RATE=16000

# DEV_HTTPS=true
# DEV_HTTPS_CERT_FILE=.cert/dev-cert.pem
# DEV_HTTPS_KEY_FILE=.cert/dev-key.pem
# DEV_CERT_HOSTS=localhost,127.0.0.1,your-pi-lan-ip,raspberrypi.local

# FEATURE_BROWSER_MIC_TESTING=true
# FEATURE_PI_VOICE_MODE=true
# FEATURE_ASSISTANT_DEBUG=false
